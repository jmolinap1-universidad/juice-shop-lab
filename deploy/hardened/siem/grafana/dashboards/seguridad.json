{
  "uid": "siem-juice",
  "title": "SIEM - Juice Shop endurecido (Fase 6)",
  "tags": [
    "seguridad",
    "waf",
    "rasp",
    "fase-6"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
