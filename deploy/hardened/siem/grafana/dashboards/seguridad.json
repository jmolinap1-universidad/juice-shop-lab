        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki-lab"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{status}}",
          "expr": "sum by (status) (count_over_time({job=\"waf_access\"}[1m]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Cestas distintas accedidas en 5 min (monitoreo BOLA)",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki-lab"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "max"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (uri) (count_over_time({job=\"waf_access\", status=\"200\"} | json | uri=~\"/rest/basket/[0-9]+\" [5m])))"
        }
      ]
