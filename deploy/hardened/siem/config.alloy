// Grafana Alloy v1.10.2 – agente de recolección del SIEM (Fase 6).
// Centraliza en Loki: (1) audit log JSON de ModSecurity, (2) access log JSON del WAF,
// (3) salida estándar de la app (incluye las detecciones del RASP Aikido Zen) y del WAF.

logging {
  level = "warn"
}

// ---------- 1) Auditoría del WAF (ModSecurity, JSON, una transacción por línea) ----------
local.file_match "waf_audit" {
  path_targets = [{"__path__" = "/var/log/waf/audit.log", "job" = "waf_audit", "fuente" = "waf"}]
}

loki.source.file "waf_audit" {
  targets    = local.file_match.waf_audit.targets
  forward_to = [loki.process.waf_audit.receiver]
}

loki.process "waf_audit" {
  // Cierre Fase 6 (A09:2025): ModSecurity guarda las CABECERAS de la petición en el audit log, incluido
  // "Authorization: Bearer <JWT>" y cookies de sesión; llegaban sin filtrar a Loki y al panel de Grafana.
  // Se redactan ANTES de enviar a Loki (el archivo crudo del WAF queda solo en el host, ignorado por git).
  stage.replace {
    expression = "\"(?i:authorization|cookie|set-cookie)\":\"([^\"]*)\""
    replace    = "[REDACTADO]"
  }
  stage.replace {
    expression = "(eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,})"
    replace    = "[JWT-REDACTADO]"
  }
  stage.json {
    expressions = { status = "transaction.response.http_code" }
  }
  stage.labels {
    values = { status = "" }
  }
  forward_to = [loki.write.local.receiver]
}

// ---------- 2) Acceso del WAF (nginx, JSON) ----------
local.file_match "waf_access" {
  path_targets = [{"__path__" = "/var/log/waf/access.log", "job" = "waf_access", "fuente" = "waf"}]
}

loki.source.file "waf_access" {
  targets    = local.file_match.waf_access.targets
  forward_to = [loki.process.waf_access.receiver]
}

loki.process "waf_access" {
  stage.replace {
    expression = "(eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,})"
    replace    = "[JWT-REDACTADO]"
  }
  stage.json {
    expressions = { status = "status", method = "method" }
  }
  stage.labels {
    values = { status = "", method = "" }
  }
  forward_to = [loki.write.local.receiver]
}

// ---------- 3) stdout de los contenedores del entorno endurecido (app + RASP, WAF) ----------
// Se consulta la API de Docker a traves de un proxy de SOLO LECTURA (siem-socket-proxy): Alloy no monta
// docker.sock ni corre como root (riesgo R24).
discovery.docker "contenedores" {
  host = "tcp://socket-proxy:2375"
  // Cierre Fase 6: al recrear un contenedor se perdían las líneas emitidas antes del siguiente descubrimiento
  // (60 s por defecto). Con 5 s el hueco se reduce (evidence/fase-6/cierre-final-2026-11-21/10-siem/).
  refresh_interval = "5s"
}

discovery.relabel "contenedores" {
  targets = discovery.docker.contenedores.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["container"]
    // siem-notificador (cierre técnico): las notificaciones de Alertmanager quedan auditadas en el SIEM
    regex         = "juice-hardened|juice-waf|siem-notificador|siem-colector-render"
    action        = "keep"
  }
}

loki.source.docker "contenedores" {
  host       = "tcp://socket-proxy:2375"
  targets    = discovery.relabel.contenedores.output
  labels     = {"job" = "docker", "fuente" = "runtime"}
  forward_to = [loki.process.runtime.receiver]
}

loki.process "runtime" {
  stage.replace {
    expression = "(eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,})"
    replace    = "[JWT-REDACTADO]"
  }
  forward_to = [loki.write.local.receiver]
}

// ---------- Destino ----------
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
  // Cierre técnico: toda línea lleva su entorno para no mezclar el laboratorio local con un despliegue cloud.
  external_labels = { entorno = "local" }
}
