{"$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json", "version": "2.1.0", "runs": [{"tool": {"driver": {"name": "Checkov", "version": "3.4.0", "informationUri": "https://checkov.io", "rules": [{"id": "CKV_AWS_336", "name": "Ensure ECS containers are limited to read-only access to root filesystems", "shortDescription": {"text": "Ensure ECS containers are limited to read-only access to root filesystems"}, "fullDescription": {"text": "Ensure ECS containers are limited to read-only access to root filesystems"}, "help": {"text": "Ensure ECS containers are limited to read-only access to root filesystems\nResource: aws_ecs_task_definition.app"}, "defaultConfiguration": {"level": "error"}, "helpUri": "https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-general-policies/bc-aws-336"}, {"id": "CKV2_AWS_62", "name": "Ensure S3 buckets should have event notifications enabled", "shortDescription": {"text": "Ensure S3 buckets should have event notifications enabled"}, "fullDescription": {"text": "Ensure S3 buckets should have event notifications enabled"}, "help": {"text": "Ensure S3 buckets should have event notifications enabled\nResource: aws_s3_bucket.logs"}, "defaultConfiguration": {"level": "error"}, "helpUri": "https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-logging-policies/bc-aws-2-62"}, {"id": "CKV_AWS_18", "name": "Ensure the S3 bucket has access logging enabled", "shortDescription": {"text": "Ensure the S3 bucket has access logging enabled"}, "fullDescription": {"text": "Ensure the S3 bucket has access logging enabled"}, "help": {"text": "Ensure the S3 bucket has access logging enabled\nResource: aws_s3_bucket.logs"}, "defaultConfiguration": {"level": "error"}, "helpUri": "https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/s3-policies/s3-13-enable-logging"}, {"id": "CKV_AWS_144", "name": "Ensure that S3 bucket has cross-region replication enabled", "shortDescription": {"text": "Ensure that S3 bucket has cross-region replication enabled"}, "fullDescription": {"text": "Ensure that S3 bucket has cross-region replication enabled"}, "help": {"text": "Ensure that S3 bucket has cross-region replication enabled\nResource: aws_s3_bucket.logs"}, "defaultConfiguration": {"level": "error"}, "helpUri": "https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-general-policies/ensure-that-s3-bucket-has-cross-region-replication-enabled"}, {"id": "CKV_AWS_145", "name": "Ensure that S3 buckets are encrypted with KMS by default", "shortDescription": {"text": "Ensure that S3 buckets are encrypted with KMS by default"}, "fullDescription": {"text": "Ensure that S3 buckets are encrypted with KMS by default"}, "help": {"text": "Ensure that S3 buckets are encrypted with KMS by default\nResource: aws_s3_bucket.logs"}, "defaultConfiguration": {"level": "error"}, "helpUri": "https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-general-policies/ensure-that-s3-buckets-are-encrypted-with-kms-by-default"}], "organization": "bridgecrew"}}, "results": [{"ruleId": "CKV_AWS_336", "ruleIndex": 0, "level": "warning", "attachments": [], "message": {"text": "Ensure ECS containers are limited to read-only access to root filesystems"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/app.tf"}, "region": {"startLine": 29, "endLine": 58, "snippet": {"text": "resource \"aws_ecs_task_definition\" \"app\" {\n  #checkov:skip=CKV_AWS_336:Juice Shop escribe la BD SQLite y logs en su \u00e1rbol de trabajo al iniciar; mitigado con usuario no root, drop ALL y FS de solo lectura en el compose endurecido local (Fase 5).\n  family                   = var.name\n  requires_compatibilities = [\"FARGATE\"]\n  network_mode             = \"awsvpc\"\n  cpu                      = \"512\"\n  memory                   = \"1024\"\n  execution_role_arn       = aws_iam_role.execution.arn\n  task_role_arn            = aws_iam_role.task.arn\n\n  container_definitions = jsonencode([{\n    name                   = \"juice-shop\"\n    image                  = var.image\n    essential              = true\n    readonlyRootFilesystem = false # Juice Shop escribe en data/ y logs/ (ver docs/fase-5)\n    user                   = \"65532\"\n    privileged             = false\n    linuxParameters        = { capabilities = { drop = [\"ALL\"] }, initProcessEnabled = true }\n    portMappings           = [{ containerPort = 3000, protocol = \"tcp\" }]\n    environment            = [{ name = \"NODE_ENV\", value = \"production\" }]\n    logConfiguration = {\n      logDriver = \"awslogs\"\n      options = {\n        awslogs-group         = aws_cloudwatch_log_group.app.name\n        awslogs-region        = var.region\n        awslogs-stream-prefix = \"app\"\n      }\n    }\n  }])\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": "Juice Shop escribe la BD SQLite y logs en su \u00e1rbol de trabajo al iniciar; mitigado con usuario no root, drop ALL y FS de solo lectura en el compose endurecido local (Fase 5)."}]}, {"ruleId": "CKV2_AWS_62", "ruleIndex": 1, "level": "warning", "attachments": [], "message": {"text": "Ensure S3 buckets should have event notifications enabled"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/app.tf"}, "region": {"startLine": 81, "endLine": 88, "snippet": {"text": "resource \"aws_s3_bucket\" \"logs\" {\n  # Riesgos aceptados (ISO/IEC 27005), documentados en docs/fase-2:\n  #checkov:skip=CKV_AWS_145:Los access logs de ALB solo admiten SSE-S3 (AES-256); SSE-KMS no es compatible.\n  #checkov:skip=CKV_AWS_18:Bucket destino de logs; registrar su acceso en s\u00ed mismo crea bucles. Se cubre con CloudTrail data events.\n  #checkov:skip=CKV_AWS_144:Replicaci\u00f3n entre regiones fuera de presupuesto del laboratorio (D-05).\n  #checkov:skip=CKV2_AWS_62:Sin consumidor de eventos; la ingesta al SIEM se hace por lectura programada.\n  bucket = \"${var.name}-alb-logs-${var.account_id}\"\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": "Sin consumidor de eventos; la ingesta al SIEM se hace por lectura programada."}]}, {"ruleId": "CKV_AWS_18", "ruleIndex": 2, "level": "warning", "attachments": [], "message": {"text": "Ensure the S3 bucket has access logging enabled"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/app.tf"}, "region": {"startLine": 81, "endLine": 88, "snippet": {"text": "resource \"aws_s3_bucket\" \"logs\" {\n  # Riesgos aceptados (ISO/IEC 27005), documentados en docs/fase-2:\n  #checkov:skip=CKV_AWS_145:Los access logs de ALB solo admiten SSE-S3 (AES-256); SSE-KMS no es compatible.\n  #checkov:skip=CKV_AWS_18:Bucket destino de logs; registrar su acceso en s\u00ed mismo crea bucles. Se cubre con CloudTrail data events.\n  #checkov:skip=CKV_AWS_144:Replicaci\u00f3n entre regiones fuera de presupuesto del laboratorio (D-05).\n  #checkov:skip=CKV2_AWS_62:Sin consumidor de eventos; la ingesta al SIEM se hace por lectura programada.\n  bucket = \"${var.name}-alb-logs-${var.account_id}\"\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": "Bucket destino de logs; registrar su acceso en s\u00ed mismo crea bucles. Se cubre con CloudTrail data events."}]}, {"ruleId": "CKV_AWS_144", "ruleIndex": 3, "level": "warning", "attachments": [], "message": {"text": "Ensure that S3 bucket has cross-region replication enabled"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/app.tf"}, "region": {"startLine": 81, "endLine": 88, "snippet": {"text": "resource \"aws_s3_bucket\" \"logs\" {\n  # Riesgos aceptados (ISO/IEC 27005), documentados en docs/fase-2:\n  #checkov:skip=CKV_AWS_145:Los access logs de ALB solo admiten SSE-S3 (AES-256); SSE-KMS no es compatible.\n  #checkov:skip=CKV_AWS_18:Bucket destino de logs; registrar su acceso en s\u00ed